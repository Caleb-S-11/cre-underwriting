# Anthropic API
ANTHROPIC_API_KEY=sk-ant-...

# Google Cloud Service Account (JSON string or path to JSON file)
# Option 1: Path to credentials file
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# Option 2: Or as JSON string (if using Railway/similar)
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Google Sheet Template File ID (the template you want to copy)
GOOGLE_TEMPLATE_FILE_ID=your-template-file-id-here

# Server
PORT=3000
NODE_ENV=development
